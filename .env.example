# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (NEVER expose to the browser)
# Used for admin operations and server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL for email redirects (used in password reset, email confirmation)
# Set this to your production URL when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000
